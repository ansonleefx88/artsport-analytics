# Copy this file to .env and fill it in. Never share .env or put it on GitHub.

# Port the site runs on: http://SERVER-IP:3000
PORT=3000

# Password for /crm (leads + analytics). Use a long one.
CRM_PASSWORD=change-me-to-a-long-password

# Own analytics: 1 = on
ANALYTICS_ENABLED=1
# Websites that may send analytics (first one shows by default in the CRM). Add HubSpot clients here.
ANALYTICS_SITES=adtomatic

# Where leads + analytics are saved (default: ./data). Back this folder up.
# DATA_DIR=/var/adtomatic-data

# Meta Conversions API (fill in when ads start)
META_PIXEL_ID=
META_CAPI_TOKEN=
# META_TEST_EVENT_CODE=
